generator client {
  provider            = "prisma-client"
  output              = "../codigo/gerado/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  USUARIO_NORMAL
  USUARIO_ADMIN
  USUARIO_MASTER
}

enum StatusDespesa {
  PENDENTE
  PAGA
}

enum StatusRateio {
  PENDENTE
  PARCIAL
  PAGO
}

enum StatusTarefa {
  ABERTA
  CONCLUIDA
}

model Usuario {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String      @db.VarChar(120)
  email       String      @unique @db.VarChar(254)
  senhaHash   String      @map("senha_hash") @db.VarChar(255)
  tipoUsuario TipoUsuario @default(USUARIO_NORMAL) @map("tipo_usuario")
  ativo       Boolean     @default(true)
  versaoToken Int         @default(0) @map("versao_token")
  excluidoEm  DateTime?   @map("excluido_em") @db.Timestamptz(3)
  criadoEm    DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  republicasAdministradas Republica[]       @relation("Administrador")
  membros                 MembroRepublica[]
  despesasCriadas         Despesa[]

  @@map("usuarios")
}

model Republica {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String   @db.VarChar(120)
  endereco      String?  @db.VarChar(255)
  codigoEntrada String   @unique @map("codigo_entrada") @db.VarChar(32)
  adminId       String   @map("admin_id") @db.Uuid
  ativa         Boolean  @default(true)
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  administrador Usuario           @relation("Administrador", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membros       MembroRepublica[]
  despesas      Despesa[]
  tarefas       Tarefa[]

  @@index([adminId])
  @@map("republicas")
}

model MembroRepublica {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  republicaId String   @map("republica_id") @db.Uuid
  ativo       Boolean  @default(true)
  entrouEm    DateTime @default(now()) @map("entrou_em") @db.Timestamptz(3)

  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  republica  Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rateios    RateioDespesa[]
  pagamentos Pagamento[]
  tarefas    Tarefa[]

  @@unique([usuarioId, republicaId])
  @@index([republicaId, ativo])
  @@map("membros_republica")
}

model Despesa {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId String        @map("republica_id") @db.Uuid
  criadaPorId String        @map("criada_por_id") @db.Uuid
  titulo      String        @db.VarChar(160)
  categoria   String        @db.VarChar(80)
  valorTotal  Decimal       @map("valor_total") @db.Decimal(12, 2)
  vencimento  DateTime      @db.Date
  status      StatusDespesa @default(PENDENTE)
  criadaEm    DateTime      @default(now()) @map("criada_em") @db.Timestamptz(3)

  republica Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criadaPor Usuario         @relation(fields: [criadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rateios   RateioDespesa[]

  @@index([republicaId, status, vencimento])
  @@index([criadaPorId])
  @@map("despesas")
}

model RateioDespesa {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  despesaId   String       @map("despesa_id") @db.Uuid
  membroId    String       @map("membro_id") @db.Uuid
  valorDevido Decimal      @map("valor_devido") @db.Decimal(12, 2)
  valorPago   Decimal      @default(0) @map("valor_pago") @db.Decimal(12, 2)
  status      StatusRateio @default(PENDENTE)

  despesa   Despesa         @relation(fields: [despesaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro    MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pagamentos Pagamento[]

  @@unique([despesaId, membroId])
  @@index([membroId, status])
  @@map("rateios_despesa")
}

model Pagamento {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateioId       String   @map("rateio_id") @db.Uuid
  chaveIdempotencia String @unique @default(dbgenerated("gen_random_uuid()")) @map("chave_idempotencia") @db.Uuid
  hashRequisicao String? @map("hash_requisicao") @db.VarChar(64)
  membroId       String   @map("membro_id") @db.Uuid
  valor          Decimal  @db.Decimal(12, 2)
  comprovanteUrl String?  @map("comprovante_url") @db.VarChar(500)
  dataPagamento  DateTime @default(now()) @map("data_pagamento") @db.Timestamptz(3)

  rateio RateioDespesa   @relation(fields: [rateioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([membroId, dataPagamento])
  @@index([rateioId])
  @@map("pagamentos")
}

model Tarefa {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId   String       @map("republica_id") @db.Uuid
  responsavelId String       @map("responsavel_id") @db.Uuid
  titulo        String       @db.VarChar(160)
  descricao     String?
  prazo         DateTime?    @db.Date
  status        StatusTarefa @default(ABERTA)
  criadaEm      DateTime     @default(now()) @map("criada_em") @db.Timestamptz(3)

  republica   Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsavel MembroRepublica @relation(fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([republicaId, status, prazo])
  @@index([responsavelId, status])
  @@map("tarefas")
}
