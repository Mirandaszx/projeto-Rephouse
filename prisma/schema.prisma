generator client {
  provider            = "prisma-client"
  output              = "../codigo/gerado/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  USUARIO_NORMAL
  USUARIO_ADMIN
  USUARIO_MASTER
}

enum StatusDespesa {
  PENDENTE
  PAGA
}

enum StatusRateio {
  PENDENTE
  PARCIAL
  PAGO
}

enum StatusTarefa {
  ABERTA
  CONCLUIDA
}

model Usuario {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String      @db.VarChar(120)
  email       String      @unique @db.VarChar(254)
  senhaHash   String?     @map("senha_hash") @db.VarChar(255)
  tipoUsuario TipoUsuario @default(USUARIO_NORMAL) @map("tipo_usuario")
  ativo       Boolean     @default(true)
  versaoToken Int         @default(0) @map("versao_token")
  excluidoEm  DateTime?   @map("excluido_em") @db.Timestamptz(3)
  criadoEm    DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  republicasAdministradas Republica[]       @relation("Administrador")
  membros                 MembroRepublica[]
  despesasCriadas         Despesa[]
  identidadeGoogle        IdentidadeGoogle?
  desafiosGoogle          DesafioGoogle[]
  recorrenciasCriadas     RecorrenciaDespesa[]
  competenciasRevisadas   CompetenciaRecorrencia[]
  operacoesCriacao        OperacaoCriacao[]
  emailVerificado        EmailVerificado?
  linksEmail             LinkEmail[]
  tarefasCriadas         Tarefa[] @relation("CriadorTarefa")
  eventosNotificacao     EventoNotificacao[]
  foto                   FotoPerfil?

  @@map("usuarios")
}

model FotoPerfil {
  usuarioId String @id @map("usuario_id") @db.Uuid
  conteudo Bytes
  mimeType String @map("mime_type") @db.VarChar(32)
  tamanho Int
  hashSha256 String @map("hash_sha256") @db.Char(64)
  atualizadaEm DateTime @default(now()) @map("atualizada_em") @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("fotos_perfil")
}

model EmailVerificado {
  usuarioId String @id @map("usuario_id") @db.Uuid
  verificadoEm DateTime @default(now()) @map("verificado_em") @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("emails_verificados")
}

model LinkEmail {
  id String @id @db.Uuid
  finalidade String @db.VarChar(10)
  email String @db.VarChar(254)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  cookieHash String @map("cookie_hash") @db.Char(64)
  usuarioId String? @map("usuario_id") @db.Uuid
  versaoToken Int? @map("versao_token")
  nome String? @db.VarChar(120)
  senhaHash String? @map("senha_hash") @db.VarChar(255)
  acaoRepublica String? @map("acao_republica") @db.VarChar(6)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  expiraEm DateTime @map("expira_em") @db.Timestamptz(3)
  consumidoEm DateTime? @map("consumido_em") @db.Timestamptz(3)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([email, finalidade, criadoEm(sort: Desc)], map: "links_email_consulta_idx")
  @@index([expiraEm], map: "links_email_expiracao_idx")
  @@map("links_email")
}

model LimiteEnvioEmail {
  emailHash String @id @map("email_hash") @db.Char(64)
  janelaInicio DateTime @map("janela_inicio") @db.Timestamptz(3)
  ultimoEnvio DateTime @map("ultimo_envio") @db.Timestamptz(3)
  quantidade Int
  @@map("limites_envio_email")
}

model IdentidadeGoogle {
  sub String @id @db.VarChar(255)
  usuarioId String @unique @map("usuario_id") @db.Uuid
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("identidades_google")
}

model DesafioGoogle {
  id String @id @db.Uuid
  nonceHash String @map("nonce_hash") @db.Char(64)
  cookieHash String @map("cookie_hash") @db.Char(64)
  finalidade String @db.VarChar(20)
  usuarioId String? @map("usuario_id") @db.Uuid
  versaoToken Int? @map("versao_token")
  expiraEm DateTime @map("expira_em") @db.Timestamptz(3)
  consumidoEm DateTime? @map("consumido_em") @db.Timestamptz(3)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([expiraEm])
  @@map("desafios_google")
}

model Republica {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String   @db.VarChar(120)
  endereco      String?  @db.VarChar(255)
  codigoEntrada String   @unique @map("codigo_entrada") @db.VarChar(32)
  adminId       String   @map("admin_id") @db.Uuid
  ativa         Boolean  @default(true)
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  administrador Usuario           @relation("Administrador", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membros       MembroRepublica[]
  despesas      Despesa[]
  tarefas       Tarefa[]
  recorrencias  RecorrenciaDespesa[]
  operacoesCriacao OperacaoCriacao[]
  eventosNotificacao EventoNotificacao[]

  @@index([adminId])
  @@map("republicas")
}

model MembroRepublica {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  republicaId String   @map("republica_id") @db.Uuid
  ativo       Boolean  @default(true)
  entrouEm    DateTime @default(now()) @map("entrou_em") @db.Timestamptz(3)

  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  republica  Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rateios    RateioDespesa[]
  pagamentos Pagamento[]
  selecoesRecorrentes RecorrenciaParticipante[]
  tarefas    Tarefa[]
  notificacoes Notificacao[]
  eventosVinculo EventoNotificacao[]

  @@unique([usuarioId, republicaId])
  @@index([republicaId, ativo])
  @@map("membros_republica")
}

model Despesa {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId String        @map("republica_id") @db.Uuid
  criadaPorId String        @map("criada_por_id") @db.Uuid
  titulo      String        @db.VarChar(160)
  categoria   String        @db.VarChar(80)
  valorTotal  Decimal       @map("valor_total") @db.Decimal(12, 2)
  vencimento  DateTime      @db.Date
  status      StatusDespesa @default(PENDENTE)
  criadaEm    DateTime      @default(now()) @map("criada_em") @db.Timestamptz(3)

  republica Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criadaPor Usuario         @relation(fields: [criadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rateios   RateioDespesa[]
  competenciaRecorrente CompetenciaRecorrencia?
  recorrenciaOriginada RecorrenciaDespesa?
  operacaoCriacao OperacaoCriacao?

  @@index([republicaId, status, vencimento])
  @@index([criadaPorId])
  @@index([vencimento, republicaId], map: "despesas_competencia_idx")
  @@map("despesas")
}

model RateioDespesa {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  despesaId   String       @map("despesa_id") @db.Uuid
  membroId    String       @map("membro_id") @db.Uuid
  valorDevido Decimal      @map("valor_devido") @db.Decimal(12, 2)
  valorPago   Decimal      @default(0) @map("valor_pago") @db.Decimal(12, 2)
  status      StatusRateio @default(PENDENTE)

  despesa   Despesa         @relation(fields: [despesaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro    MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pagamentos Pagamento[]
  eventosNotificacao EventoNotificacao[]

  @@unique([despesaId, membroId])
  @@index([membroId, status])
  @@map("rateios_despesa")
}

model Pagamento {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateioId       String   @map("rateio_id") @db.Uuid
  chaveIdempotencia String @unique @default(dbgenerated("gen_random_uuid()")) @map("chave_idempotencia") @db.Uuid
  hashRequisicao String? @map("hash_requisicao") @db.VarChar(64)
  membroId       String   @map("membro_id") @db.Uuid
  valor          Decimal  @db.Decimal(12, 2)
  comprovanteUrl String?  @map("comprovante_url") @db.VarChar(500)
  dataPagamento  DateTime @default(now()) @map("data_pagamento") @db.Timestamptz(3)

  rateio RateioDespesa   @relation(fields: [rateioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comprovante Comprovante?

  @@index([membroId, dataPagamento])
  @@index([rateioId])
  @@map("pagamentos")
}

model Comprovante {
  pagamentoId String @id @map("pagamento_id") @db.Uuid
  conteudo Bytes
  mimeType String @map("mime_type") @db.VarChar(100)
  tamanho Int
  hashSha256 String @map("hash_sha256") @db.Char(64)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  pagamento Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("comprovantes")
}

model Tarefa {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId   String       @map("republica_id") @db.Uuid
  responsavelId String?      @map("responsavel_id") @db.Uuid
  criadorId     String?      @map("criador_id") @db.Uuid
  versao        Int          @default(0)
  titulo        String       @db.VarChar(160)
  descricao     String?
  prazo         DateTime?    @db.Date
  status        StatusTarefa @default(ABERTA)
  criadaEm      DateTime     @default(now()) @map("criada_em") @db.Timestamptz(3)

  republica   Republica       @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsavel MembroRepublica? @relation(fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criador Usuario? @relation("CriadorTarefa", fields: [criadorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventosNotificacao EventoNotificacao[]
  operacaoCriacao OperacaoCriacao?

  @@index([republicaId, status, prazo])
  @@index([responsavelId, status])
  @@map("tarefas")
}

model EventoNotificacao {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId String @map("republica_id") @db.Uuid
  categoria String @db.VarChar(10)
  tipo String @db.VarChar(32)
  titulo String @db.VarChar(160)
  atorId String? @map("ator_id") @db.Uuid
  tarefaId String? @map("tarefa_id") @db.Uuid
  tarefaVersao Int? @map("tarefa_versao")
  membroEventoId String? @map("membro_evento_id") @db.Uuid
  rateioId String? @map("rateio_id") @db.Uuid
  vencimento DateTime? @db.Date
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  republica Republica @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ator Usuario? @relation(fields: [atorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tarefa Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rateio RateioDespesa? @relation(fields: [rateioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membroEvento MembroRepublica? @relation(fields: [membroEventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinatarios Notificacao[]
  @@unique([tarefaId, tarefaVersao, tipo], map: "eventos_tarefa_versao_tipo_key")
  @@unique([rateioId, vencimento, tipo], map: "eventos_rateio_vencimento_tipo_key")
  @@index([membroEventoId])
  @@index([republicaId, criadoEm])
  @@map("eventos_notificacao")
}

model Notificacao {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId String @map("evento_id") @db.Uuid
  membroId String @map("membro_id") @db.Uuid
  lidaEm DateTime? @map("lida_em") @db.Timestamptz(3)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  evento EventoNotificacao @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([eventoId, membroId])
  @@index([membroId, lidaEm, criadoEm])
  @@map("notificacoes")
}

model OperacaoCriacao {
  usuarioId String @map("usuario_id") @db.Uuid
  operacao String @db.VarChar(16)
  chave String @db.Uuid
  republicaId String @map("republica_id") @db.Uuid
  hashRequisicao String @map("hash_requisicao") @db.Char(64)
  despesaId String? @unique @map("despesa_id") @db.Uuid
  tarefaId String? @unique @map("tarefa_id") @db.Uuid
  resposta Json
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  republica Republica @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  despesa Despesa? @relation(fields: [despesaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tarefa Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([usuarioId, operacao, chave], map: "operacoes_criacao_pkey")
  @@index([republicaId], map: "operacoes_criacao_republica_idx")
  @@map("operacoes_criacao")
}

model RecorrenciaDespesa {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  republicaId String @map("republica_id") @db.Uuid
  criadaPorId String @map("criada_por_id") @db.Uuid
  despesaOrigemId String? @unique @map("despesa_origem_id") @db.Uuid
  inicio DateTime @db.Date
  fim DateTime? @db.Date
  proximaCompetencia DateTime @map("proxima_competencia") @db.Date
  ativa Boolean @default(true)
  pausaMotivo String? @map("pausa_motivo") @db.VarChar(60)
  chaveIdempotencia String @unique @map("chave_idempotencia") @db.Uuid
  hashRequisicao String @map("hash_requisicao") @db.Char(64)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  republica Republica @relation(fields: [republicaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criadaPor Usuario @relation(fields: [criadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  despesaOrigem Despesa? @relation(fields: [despesaOrigemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configuracoes ConfiguracaoRecorrencia[]
  competencias CompetenciaRecorrencia[]
  @@index([ativa, pausaMotivo, proximaCompetencia])
  @@index([republicaId, criadaEm])
  @@map("recorrencias_despesa")
}

model ConfiguracaoRecorrencia {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versao Int @unique @default(autoincrement())
  recorrenciaId String @map("recorrencia_id") @db.Uuid
  vigencia DateTime @db.Date
  titulo String @db.VarChar(160)
  categoria String @db.VarChar(80)
  valorTotal Decimal @map("valor_total") @db.Decimal(12, 2)
  diaVencimento Int @map("dia_vencimento")
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  recorrencia RecorrenciaDespesa @relation(fields: [recorrenciaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participantes RecorrenciaParticipante[]
  competencias CompetenciaRecorrencia[]
  @@index([recorrenciaId, vigencia, criadaEm])
  @@map("configuracoes_recorrencia")
}

model RecorrenciaParticipante {
  configuracaoId String @map("configuracao_id") @db.Uuid
  membroId String @map("membro_id") @db.Uuid
  configuracao ConfiguracaoRecorrencia @relation(fields: [configuracaoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membro MembroRepublica @relation(fields: [membroId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([configuracaoId, membroId])
  @@index([membroId])
  @@map("recorrencias_participantes")
}

model CompetenciaRecorrencia {
  recorrenciaId String @map("recorrencia_id") @db.Uuid
  competencia DateTime @db.Date
  configuracaoId String? @map("configuracao_id") @db.Uuid
  despesaId String? @unique @map("despesa_id") @db.Uuid
  estado String @db.VarChar(24)
  motivo String? @db.VarChar(60)
  snapshot Json?
  revisadaPorId String? @map("revisada_por_id") @db.Uuid
  revisadaEm DateTime? @map("revisada_em") @db.Timestamptz(3)
  recorrencia RecorrenciaDespesa @relation(fields: [recorrenciaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  configuracao ConfiguracaoRecorrencia? @relation(fields: [configuracaoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  despesa Despesa? @relation(fields: [despesaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisadaPor Usuario? @relation(fields: [revisadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([recorrenciaId, competencia])
  @@index([estado, competencia])
  @@map("competencias_recorrencia")
}
