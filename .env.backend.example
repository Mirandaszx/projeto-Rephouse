BACKEND_DB_USER=rephouse
BACKEND_DB_NAME=rabbu_mvp
BACKEND_DB_PASSWORD=preencha_com_senha_local
# Codifique caracteres especiais de usuário/senha para URL. Host interno: postgres.
BACKEND_DATABASE_URL=postgresql://rephouse:preencha_com_senha_local@postgres:5432/rabbu_mvp?schema=public
BACKEND_JWT_SECRET=preencha_com_segredo_aleatorio_de_pelo_menos_32_caracteres
BACKEND_PORT=3001
BACKEND_TIME_ZONE=America/Sao_Paulo
BACKEND_CORS_ORIGINS=
# Opcional: Client ID público Google. Configure também a origem exata em BACKEND_CORS_ORIGINS.
# GOOGLE_CLIENT_ID=123456789-exemplo.apps.googleusercontent.com
# Opcional, configurar em conjunto: a chave de UM provedor (Brevo ou Resend), EMAIL_FROM e APP_PUBLIC_URL.
# BREVO_API_KEY=xkeysib-configure_localmente
# RESEND_API_KEY=re_configure_localmente
# EMAIL_FROM=onboarding@resend.dev
# APP_PUBLIC_URL=http://localhost:5173
# Opcional (LGPD): e-mail que aparece na política de privacidade para pedidos de titulares. Sem ele, usa EMAIL_FROM.
# PRIVACY_CONTACT_EMAIL=privacidade@exemplo.com
