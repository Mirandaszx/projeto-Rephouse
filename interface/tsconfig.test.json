{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "playwright.pr2.config.ts", "testes/encerrar-ambiente.ts", "testes-pr2/**/*.ts"]
}
