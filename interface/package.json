{
  "name": "frontend",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint codigo",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:pr2": "playwright test --config playwright.pr2.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json",
    "verificar": "npm run build && npm run typecheck && npm run lint && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "glisse": "0.5.0",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "react": "^19.2.8",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  }
