{
  "name": "projeto-rephouse",
  "version": "2.0.0",
  "description": "Sistema web simples para gestão e organização de repúblicas e residências compartilhadas.",
  "main": "dist/server.js",
  "directories": {
    "doc": "documentacao"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch codigo/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.carga.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "verificar": "tsx codigo/comandos/verificar-backend.ts",
    "api:exportar": "tsx codigo/comandos/exportar-openapi.ts",
    "auth:secret": "tsx codigo/comandos/generate-secret.ts",
    "master:provision": "tsx codigo/comandos/provision-master.ts",
    "test": "tsx --test --test-concurrency=1 testes/rateio.test.ts testes/http.test.ts testes/integracao-http.test.ts testes/operacao-http.test.ts testes/backup.test.ts testes/robustez.test.ts",
    "test:db": "tsx --test --test-concurrency=1 testes/database.test.ts testes/acid.test.ts testes/migration.test.ts",
    "backup": "tsx codigo/comandos/backup.ts",
    "restaurar": "tsx codigo/comandos/restaurar.ts",
    "test:devops": "tsx codigo/comandos/verificar-devops.ts",
    "comprovantes:verificar": "tsx codigo/comandos/verificar-comprovantes.ts",
    "test:carga": "tsx codigo/comandos/verificar-carga.ts curto",
    "test:carga:completo": "tsx codigo/comandos/verificar-carga.ts completo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mirandaszx/projeto-Rephouse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Mirandaszx/projeto-Rephouse/issues"
  },
  "homepage": "https://github.com/Mirandaszx/projeto-Rephouse#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/k6": "2.3.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "prisma@7.10.0": {
      "mysql2": "3.24.6"
    },
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
