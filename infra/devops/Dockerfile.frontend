FROM node:24-bookworm-slim AS build
WORKDIR /workspace/interface
COPY interface/package.json interface/package-lock.json ./
RUN npm ci
COPY interface ./
COPY integracao /workspace/integracao
RUN npm run build

FROM nginx:1.30.7-alpine AS runtime
# Aplica as correções já publicadas pelo Alpine (ex.: libxml2) antes de trocar para o usuário sem privilégios.
RUN apk upgrade --no-cache
COPY infra/devops/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/interface/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
