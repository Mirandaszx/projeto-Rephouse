NODE_ENV=development
APP_TIME_ZONE=America/Sao_Paulo
HOST=0.0.0.0
PORT=3000
JWT_SECRET=
# Opcional, somente para importar arquivos legados:
# UPLOAD_DIR=armazenamento/comprovantes
# Origens autorizadas a ler a API pelo navegador; vazio desabilita acesso entre origens.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxies confiáveis na frente da API (Vite ou Nginx = 1). Use 0 se a API recebe o navegador diretamente.
TRUST_PROXY=1
# Apenas para criar contas locais de demonstração; escolha uma senha com 12 a 128 caracteres.
DEMO_PASSWORD=
POSTGRES_DB=rabbu_mvp
POSTGRES_USER=gabrisel
POSTGRES_PASSWORD=troque_por_uma_senha_segura
DATABASE_URL=postgresql://gabrisel:troque_por_uma_senha_segura@localhost:5432/rabbu_mvp?schema=public
# Após migrations aprovadas, npm run db:permissoes gera a conta limitada e atualiza
# DATABASE_URL. A URL administrativa permanece exclusivamente para manutenção.
# MIGRATIONS_DATABASE_URL=postgresql://gabrisel:troque_por_uma_senha_segura@localhost:5432/rabbu_mvp?schema=public
API_DB_USER=rephouse_api
# Gerada automaticamente por db:permissoes (32 bytes aleatórios em hexadecimal).
API_DB_PASSWORD=
# Use um banco separado, também criado pelas migrations, para os testes de integração.
# TEST_DATABASE_URL=postgresql://gabrisel:troque_por_uma_senha_segura@localhost:5432/rabbu_mvp_test?schema=public
# Opcional: Client ID público do cliente Web Google. Sem configuração, o botão fica oculto.
# GOOGLE_CLIENT_ID=123456789-exemplo.apps.googleusercontent.com
# A autenticação por e-mail só fica disponível com a chave de UM provedor, EMAIL_FROM e APP_PUBLIC_URL.
# Segredo somente do backend. Nunca usar VITE_ nem publicar a chave.
# Brevo (grátis, sem domínio próprio; EMAIL_FROM = remetente verificado no Brevo):
# BREVO_API_KEY=xkeysib-configure_localmente
# Opcional: IDs dos modelos ativos de cadastro e login na sua conta Brevo.
# BREVO_CADASTRO_TEMPLATE_ID=1
# BREVO_LOGIN_TEMPLATE_ID=2
# EMAIL_FROM=seu.remetente@gmail.com
# Ou Resend (exige domínio verificado para enviar a qualquer pessoa):
# RESEND_API_KEY=re_configure_localmente
# EMAIL_FROM=onboarding@resend.dev
# APP_PUBLIC_URL=http://localhost:5173
# Opcional (LGPD): e-mail que aparece na política de privacidade para pedidos de titulares. Sem ele, usa EMAIL_FROM.
# PRIVACY_CONTACT_EMAIL=privacidade@exemplo.com
