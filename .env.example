NODE_ENV=development
APP_TIME_ZONE=America/Sao_Paulo
HOST=0.0.0.0
PORT=3000
JWT_SECRET=
UPLOAD_DIR=armazenamento/comprovantes
# Origens autorizadas a ler a API pelo navegador; vazio desabilita acesso entre origens.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Apenas para criar contas locais de demonstração; escolha uma senha com 12 a 128 caracteres.
DEMO_PASSWORD=
POSTGRES_DB=rabbu_mvp
POSTGRES_USER=gabrisel
POSTGRES_PASSWORD=troque_por_uma_senha_segura
DATABASE_URL=postgresql://gabrisel:troque_por_uma_senha_segura@localhost:5432/rabbu_mvp?schema=public
